{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@vinext/cloudflare": "1.2.0",
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "3.7.0",
    "vinext": "1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.65.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "next": "16.4.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --persist-to node_modules/.cache/worker-state",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts next.config.ts",
    "test": "node tests/projects.test.cjs && node tests/content.test.cjs && node tests/contact.test.cjs && node tests/indexing.test.cjs && node tests/seo.test.cjs",
    "test:browser": "node tests/project-layout.test.cjs && node tests/contact-browser.test.cjs",
    "format:check": "prettier --check \"src/{app,api,components,config,lib,types}/**/*.{ts,tsx,css}\" src/middleware.ts src/env.d.ts tests/*.cjs *.config.* package.json tsconfig.json",
    "test:contact-worker": "node tests/contact-worker.test.cjs",
    "test:live": "node tests/strapi-live.cjs"
  },
  "overrides": {
    "undici": "7.30.1",
    "fflate": "0.7.5"
  }
}
