{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-frontend",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2026102601",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  "env": {
    "production": {
      "name": "portfolio-frontend-production",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "observability": {
        "enabled": false,
        "logs": { "enabled": true, "invocation_logs": true },
      },
      "workers_dev": true,
      "preview_urls": false,
      "routes": [{ "pattern": "portfolio.marksavilledesigns.com", "custom_domain": true }],
      "vars": {
        "DEPLOYMENT_ENV": "production",
        "PORTFOLIO_FIXTURES": "false",
        "SITE_URL": "https://portfolio.marksavilledesigns.com",
        "CONTACT_ALLOWED_ORIGIN": "https://portfolio.marksavilledesigns.com",
      },
      "ratelimits": [
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "2026102601",
          "simple": { "limit": 3, "period": 60 },
        },
      ],
    },
    "staging": {
      "name": "portfolio-frontend-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "DEPLOYMENT_ENV": "staging",
        "PORTFOLIO_FIXTURES": "false",
        "SITE_URL": "https://portfolio-frontend-staging.marksav85.workers.dev",
        "CONTACT_ALLOWED_ORIGIN": "https://portfolio-frontend-staging.marksav85.workers.dev",
      },
      "ratelimits": [
        {
          "name": "CONTACT_RATE_LIMITER",
          "namespace_id": "2026102602",
          "simple": { "limit": 3, "period": 60 },
        },
      ],
    },
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"],
  },
}
